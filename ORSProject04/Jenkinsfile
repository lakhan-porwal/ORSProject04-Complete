
pipeline {
    agent any

    environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-21.0.12'
        DOCKERHUB_USER = 'lakhanporwal'
        MYSQL_IMAGE = 'lakhanporwal/mysql:8.0'
        ORS_IMAGE = 'lakhanporwal/orsproject04:latest'
    }

    stages {

        stage('Checkout Repository') {
            steps {
                checkout scm
            }
        }

        stage('Check Project Files') {
            steps {
                dir('ORSProject04') {
                    bat '''
                        echo Checking project files...
                        dir pom.xml
                        dir Dockerfile
                        dir docker-compose.yml
                    '''
                }
            }
        }

        stage('Check Java Version') {
            steps {
                bat '''
                    echo JAVA_HOME=%JAVA_HOME%
                    "%JAVA_HOME%\\bin\\java.exe" -version
                    "%JAVA_HOME%\\bin\\javac.exe" -version
                '''
            }
        }

        stage('Build New WAR') {
            steps {
                dir('ORSProject04') {
                    bat '''
                        "%JAVA_HOME%\\bin\\java.exe" -version
                        "C:\\apache-maven-3.10.0-bin\\apache-maven-3.10.0\\bin\\mvn.cmd" clean package -DskipTests
                    '''
                }
            }
        }

        stage('Pull MySQL Image') {
            steps {
                bat 'docker pull mysql:8.0'
            }
        }

        stage('Build ORS Image') {
            steps {
                dir('ORSProject04') {
                    bat 'docker build -t orsproject04:latest .'
                }
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    bat '''
                        @echo off
                        echo %DH_TOKEN%| docker login --username "%DH_USER%" --password-stdin
                    '''
                }
            }
        }

        stage('Tag Docker Images') {
            steps {
                bat '''
                    docker tag mysql:8.0 %MYSQL_IMAGE%
                    docker tag orsproject04:latest %ORS_IMAGE%
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                bat '''
                    docker push %MYSQL_IMAGE%
                    docker push %ORS_IMAGE%
                '''
            }
        }

        stage('Deploy Application') {
            steps {
                dir('ORSProject04') {
                    bat '''
                        docker compose down
                        docker compose up -d
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'ORS pipeline completed successfully!'
        }

        failure {
            echo 'ORS pipeline failed. Check Console Output.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
